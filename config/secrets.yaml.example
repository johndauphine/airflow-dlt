    username: sa
    password: YourStrong@Passw0rd

  source_pg_app:
    username: readonly
    password: changeme

  source_pg_bench:
    username: postgres
    password: TestPass2024

  target_postgres_main:
    username: postgres
    password: PostgresPassword123
